# --- SERVER SETUP ---
RUN_MODE=development
PYTJA_SERVER__HOST=127.0.0.1
PYTJA_SERVER__PORT=50051
PYTJA_SERVER__WORKER_THREADS=8

# --- SECURITY ---
PYTJA_SECURITY__JWT_SECRET=super_geheimes_enterprise_secret_key_2026

PYTJA_JWT_SECRET=super_langer_zufaelliger_string_fuer_production_123456!
PYTJA_QUOTA_LIMIT=1073741824

# --- DATENBANK ---
# SQLite deaktiviert
# PYTJA_DATABASE__PRIMARY_URL=sqlite://pytja.db

# PostgreSQL aktiviert (Zeigt auf den vom Docker-Container freigegebenen Port auf localhost)
PYTJA_DATABASE__PRIMARY_URL=postgres://pytja:securepass@localhost:5432/pytja_db

# --- STORAGE (Wähle einen!) ---
# Option A: Lokales Dateisystem (Dev)
PYTJA_STORAGE__STORAGE_TYPE=fs
PYTJA_STORAGE__LOCAL_PATH=./data/blobs

# Option B: AWS S3 / MinIO (Prod)
# PYTJA_STORAGE__STORAGE_TYPE=s3
# PYTJA_STORAGE__S3_BUCKET=pytja-bucket
# PYTJA_STORAGE__S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...